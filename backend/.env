# ──────────────────────────────────────────────────────────────────────────────
# PlantPal – Environment Variables
# Copy this file to .env and fill in real values before running the backend.
# NEVER commit .env to version control — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (must match docker-compose.yml) ──────────────────────────────────
# PostgreSQL username
DB_USERNAME=plantpal          # must match POSTGRES_USER in docker-compose.yml
# PostgreSQL password
DB_PASSWORD=plantpal          # must match POSTGRES_PASSWORD in docker-compose.yml

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis host (localhost when using docker-compose)
REDIS_HOST=localhost
# Redis port (default: 6379)
REDIS_PORT=6379

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret key for signing JWTs — minimum 64 characters for HS256.
# Generate a fresh value with: openssl rand -base64 64
JWT_SECRET=IRPoL53F7aENcDRqiY5ujblrdTC2J5nSH0E4QJEEtRpqkiX66teas0cAdhTeKVdcEQwPNK0pfp1H2rKYOG+PWw==

# ── Ollama (local AI) ─────────────────────────────────────────────────────────
# Base URL of your local Ollama instance (default port 11434).
OLLAMA_BASE_URL=http://localhost:11434
# Model to use for plant identification and chat.
# Pull a model first: ollama pull llama3
OLLAMA_MODEL=phi3
PLANTNET_API_KEY=2b10h3TxvIHMIFJk9Lyu4NUiu
# ── VAPID Keys (Web Push Notifications) ──────────────────────────────────────
# Generated with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is also shared with the Angular frontend (environment.ts).
VAPID_PUBLIC_KEY=BMe1yR59AGZSDHP6vCjeDtltw91TGOETRQBh_YvMqes3MGNRPW_yXdGH9l7Zkg-_pt_0FRSy2ore2h3RIygjhF8
VAPID_PRIVATE_KEY=9Q4j8wJC_eeVK5IoFy8O7rNt1iVxhepQSRmN1D8Uzb0
