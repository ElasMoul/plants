# ──────────────────────────────────────────────────────────────────────────────
# PlantPal – Environment Variables
# Copy this file to .env and fill in real values before running the backend.
# NEVER commit .env to version control — it is in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (must match docker-compose.yml) ──────────────────────────────────
# PostgreSQL username
DB_USERNAME=plantpal
# PostgreSQL password
DB_PASSWORD=plantpal

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis host (localhost when using docker-compose)
REDIS_HOST=localhost
# Redis port (default: 6379)
REDIS_PORT=6379

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret key for signing JWTs — minimum 64 characters for HS256.
# Generate a safe value with: openssl rand -base64 64
JWT_SECRET=replace-with-a-secure-random-string-minimum-64-characters-long-for-hs256

# ── Anthropic / Claude API ────────────────────────────────────────────────────
# API key from https://console.anthropic.com
# Used for plant identification (Vision) and the chat assistant.
ANTHROPIC_API_KEY=sk-ant-...

# ── VAPID Keys (Web Push Notifications) ──────────────────────────────────────
# Generate a key pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is also shared with the Angular frontend (environment.ts).
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
