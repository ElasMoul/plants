# ─────────────────────────────────────────────────────────────────
# PlantPal — Environment Variables Template
# Copy to backend/.env and fill in real values.
# Never commit the .env file — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
DB_USERNAME=db_name
DB_PASSWORD=db_pass

# ── Redis ─────────────────────────────────────────────────────────
# REDIS_PORT / KAFKA_BOOTSTRAP_SERVERS in this file are HOST-side ports (platform
# port block) for NATIVE runs (mvn spring-boot:run on the host). The dockerized
# backend gets container-internal overrides from docker-compose.yml's environment
# block (SPRING_DATA_REDIS_PORT=6379, KAFKA_BOOTSTRAP_SERVERS=kafka:9092) — do not
# "fix" these to container ports here, that would break native runs.
REDIS_HOST=localhost
REDIS_PORT=16379

# ── JWT (minimum 64 chars, must be valid Base64 — generate: openssl rand -base64 64) ───
JWT_SECRET=<generate: openssl rand -base64 64>

# ── Ollama (local AI — plant care planning & chat) ───────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ── PlantNet API (plant species identification) ───────────────────
# Get your key at: https://my.plantnet.org
PLANTNET_API_KEY=api_here

# ── GitHub Models (vision: identification + annotation; text: o4-mini / gpt-4.1-mini) ──
# Generate a GitHub PAT with models:read scope at: github.com/settings/tokens
GITHUB_TOKEN=your_github_pat_here
GITHUB_BASE_URL=https://models.inference.ai.azure.com
GITHUB_IDENTIFICATION_MODEL=gpt-4o
GITHUB_ANNOTATION_MODEL=gpt-4o-mini
GITHUB_GPT41_MODEL=gpt-4.1
GITHUB_O4_MINI_MODEL=o4-mini
GITHUB_GPT41_MINI_MODEL=gpt-4.1-mini

# ── DeepSeek text model (care plan + cure advice via GitHub Models endpoint) ──
DEEPSEEK_MODEL=DeepSeek-R1

# ── Anthropic (Claude — vision + reasoning). Leave blank to disable Claude options. ──
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_MAX=claude-opus-4-8

# ── Kafka (async identification pipeline) ─────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:29192

# ── Web Push VAPID keys (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Platform ai-gateway (D022 gateway swap, dev/local-only) ───────
# Leave unset in prod — defaults to false/disabled. See DEPLOYMENT.md.
PLATFORM_GATEWAY_ENABLED=true
PLATFORM_GATEWAY_URL=http://host.docker.internal:8085
