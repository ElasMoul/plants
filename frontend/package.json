{
  "name": "plantpal-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:atlas": "ng serve atlas",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "build:atlas": "ng build atlas",
    "build:atlas:prod": "ng build atlas --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck:engine": "tsc -p projects/rhizome-engine/tsconfig.json --noEmit",
    "lint": "ng lint",
    "lint:atlas": "ng lint atlas",
    "e2e": "playwright test",
    "e2e:atlas": "playwright test --config=playwright.atlas.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:visual": "playwright test e2e/journeys/visual.spec.ts --update-snapshots",
    "e2e:a11y": "playwright test e2e/journeys/accessibility.spec.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.28",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.28",
    "@angular/compiler": "^20.3.28",
    "@angular/core": "^20.3.28",
    "@angular/forms": "^20.3.28",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.28",
    "@angular/platform-browser-dynamic": "^20.3.28",
    "@angular/router": "^20.3.28",
    "@angular/service-worker": "^20.3.28",
    "@sentry/angular": "^10.70.0",
    "mermaid": "^11.15.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.34",
    "@angular/build": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.28",
    "@axe-core/playwright": "^4.9.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@types/jest": "^30.0.0",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.0.0",
    "http-server": "^14.1.1",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^26.0.0",
    "ng-packagr": "^20.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0"
  }
}
