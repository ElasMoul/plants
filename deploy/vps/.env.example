# /opt/plantpal/.env on the VPS — created once by hand, chmod 600, never committed.
# Generate each secret with:  openssl rand -hex 32   (hex keeps it URL-safe, which
# matters because the passwords are embedded in DATABASE_URL / REDIS_URL).

# ── Infrastructure ────────────────────────────────────────────────
API_DOMAIN=api.plants.moulworks.com
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ── Backend (application-prod.yml reads these; a missing one fails startup) ──
# 64+ chars: openssl rand -hex 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://plants.moulworks.com,https://plants-atlas.moulworks.com

# Keep the SAME VAPID pair as Railway — the public key is baked into both frontends.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# AI + photos: copy the values from the Railway service's Variables tab.
ANTHROPIC_API_KEY=
PLANTNET_API_KEY=
STORAGE_TYPE=cloudinary
CLOUDINARY_URL=
# application-prod.yml requires it to be set; GitHub Models is retired, any value works.
GITHUB_TOKEN=unused

# Optional one-time admin provisioning (docs/admin-console.md): register the
# account, set this, `docker compose up -d backend`, then clear it again.
APP_ADMIN_BOOTSTRAP_EMAIL=

# Do NOT set PLATFORM_* or KAFKA_* variables here — prod runs standalone, in-process.
